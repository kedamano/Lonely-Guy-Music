# 依赖与构建产物
node_modules/

# 运行时数据：登录 cookie、音源脚本、本地曲库清单（含绝对路径），绝不入库
userData/
.tmp_userdata/

# 编辑器与第三方会话数据
.idea/
.workbuddy/

# 日志与临时文件
*.log
*.tmp

# 本地临时调试目录与日志
.tmp_*

# 构建产物与发布前清理目录
dist/
.tmp_ui/
.tmp_ui2/
_lx_extract/
scripts/shots/
scripts/*.png

# 构建资源仅保留图标（其余由 npm run icons 生成）
build/*
!build/icon.ico

# 打包中间产物（dist 被占用/重试时 electron-builder 留下的副本）
dist-old*/
dist-prev*/
