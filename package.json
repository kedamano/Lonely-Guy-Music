{
  "name": "guman-music",
  "version": "1.2.2",
  "description": "孤男音乐 · 桌面音乐客户端（多平台搜索 + 洛雪音源 + 空间音频 + 实时频谱 + 卡拉OK歌词）",
  "main": "main.js",
  "author": "孤男音乐",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "server": "node server/index.js",
    "mock": "node server/mock.js",
    "icons": "node -e \"require('./assets/icon').writeIcons('build')\"",
    "fonts": "node scripts/build-fonts.js",
    "dist": "npm run icons && electron-builder --win nsis --publish never",
    "dist:dir": "npm run icons && electron-builder --win dir",
    "dist:publish": "npm run icons && electron-builder --win nsis --publish always",
    "check:platform": "node scripts/platform-url-check.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "NeteaseCloudMusicApi": "^4.32.0",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.1",
    "@fontsource/anton": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3",
    "playwright": "^1.47.2"
  }
}
